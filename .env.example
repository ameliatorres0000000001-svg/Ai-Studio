# ── Supabase (get from Project Settings → API) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Access control (REQUIRED in production) ────────────────────
# All users share the GitHub/Anthropic credentials below, so only these
# emails may use the app. In production an empty value denies everyone.
ALLOWED_USER_EMAILS=you@example.com

# ── GitHub (fine-grained PAT: Contents read/write on chosen repos) ──
GITHUB_ACCESS_TOKEN=
# Optional: restrict usable repos, e.g. "owner/repo-a,owner/*"
GITHUB_ALLOWED_REPOS=
# Optional: identity on commits made by the app
GIT_COMMIT_NAME=Claude Code Studio
GIT_COMMIT_EMAIL=studio@users.noreply.github.com

# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=
# ANTHROPIC_MAX_TOKENS=8192

# ── Vercel deploy connector (optional) ─────────────────────────
# Token: https://vercel.com/account/tokens . The Vercel GitHub integration must have
# access to the repos you deploy. Deploys the pushed branch from GitHub.
VERCEL_TOKEN=
# Optional: team scope and fixed project name (default: repo name)
VERCEL_TEAM_ID=
VERCEL_PROJECT_NAME=

# ── Telegram connector (optional) ──────────────────────────────
# Bot token from @BotFather. SERVER ONLY: never prefix with NEXT_PUBLIC_, never commit it.
# Leave empty to run without Telegram; Claude Code works normally either way.
# Requires migration supabase/migrations/20261007110000_telegram_connector.sql
TELEGRAM_BOT_TOKEN=

# ── Server storage ─────────────────────────────────────────────
# Where repos are cloned. Must be a persistent disk on the host.
# WORKSPACE_ROOT=/var/lib/ai-studio/workspaces
